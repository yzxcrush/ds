#!/bin/sh
# 快捷指令：在终端启动 Ds v0.1 编译器（交互会话）
#   启动ds            进入交互编译器会话
#   启动ds 文件.ds    编译并运行脚本
if command -v ds >/dev/null 2>&1; then
    DS_BIN=ds
else
    DS_BIN="python3 -m dsv01"
fi
if [ "$#" -gt 0 ] && [ "${1#-}" = "$1" ]; then
    exec $DS_BIN "$@"
fi
if [ ! -t 0 ] && ( : < /dev/tty ) 2>/dev/null; then
    exec $DS_BIN --repl "$@" < /dev/tty
fi
exec $DS_BIN --repl "$@"
