# Ds/Cut：RP2350 启动/向量表（Thumb）
@asm ".section .vector_table,\"a\",%progbits"
@asm ".word 0x20082000"
@asm ".word reset_handler"
@asm ".word fault_handler"
@asm ".word fault_handler"
@asm ".section .text"
@asm ".globl reset_handler"
@asm "reset_handler:"
@asm "  ldr r0, =_sdata"
@asm "  ldr r1, =_edata"
@asm "  ldr r2, =_sidata"
@asm "copy:"
@asm "  cmp r0, r1"
@asm "  bhs copy_done"
@asm "  ldr r3, [r2], #4"
@asm "  str r3, [r0], #4"
@asm "  b copy"
@asm "copy_done:"
@asm "  ldr r0, =_sbss"
@asm "  ldr r1, =_ebss"
@asm "  movs r3, #0"
@asm "zero:"
@asm "  cmp r0, r1"
@asm "  bhs zero_done"
@asm "  str r3, [r0], #4"
@asm "  b zero"
@asm "zero_done:"
@asm "  bl main"
@asm "  b ."
