#!/bin/sh
# dsos — 最小 DsOS 运行入口
# 用法：
#   dsos hello.ds        # dscc --emit bin，再加载
#   dsos hello.bin       # 直接加载
#   dsos --native x.bin  # x86_64 上真实 mmap+跳转
set -eu
here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
root=$(CDPATH= cd -- "$here/../.." && pwd)
mode=vm
if [ "${1:-}" = "--native" ]; then mode=native; shift; fi
if [ $# -ne 1 ]; then
  echo "usage: dsos [--native] <file.ds|file.bin>" >&2
  exit 2
fi
src=$1
case "$src" in
  *.ds)
    tmp=$(mktemp "${TMPDIR:-/tmp}/dsos.XXXXXX.bin")
    trap 'rm -f "$tmp"' EXIT INT TERM
    "$root/dscc" "$src" --emit bin -o "$tmp" >/dev/null
    target=$tmp ;;
  *.bin) target=$src ;;
  *) echo "dsos: 只支持 .ds / .bin" >&2; exit 2 ;;
esac
if [ "$mode" = native ]; then
  exec "${PYTHON:-python3}" "$root/dsos/toolchain/step3/loader_native.py" "$target"
else
  exec "${PYTHON:-python3}" "$root/dsos/toolchain/step3/dsos_loader.py" "$target"
fi
