          "word": "attr",
          "kind": "identifier",
          "category": "元编程",
          "position": 4,
          "form": "attr 名(目标: 属性目标) { 参数... }",
          "semantic": "声明自定义属性：目标 ∈ fn/type/class/field/static/mod/stmt/expr；声明后以 @名(参数) 使用；属性值由 comptime 代码读取，编译器不解释语义",
          "example": "attr doc(target: fn) { text: str }"
        }
      ]
    },
