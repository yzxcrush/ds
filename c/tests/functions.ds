# 函数值 / 闭包 / 默认参数
package functions

fn apply_twice(f: fn(i32) -> i32, x: i32) -> i32 {
    f(f(x))
}

fn inc(x: i32) -> i32 { x + 1 }

fn scaled(x: i32, k: i32 = 2) -> i32 {
    x * k
}

fn main() {
    println(apply_twice(inc, 10))
    println(scaled(5))
    println(scaled(5, 3))
    let f = inc
    println(f(41))
}
